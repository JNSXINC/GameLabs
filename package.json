{
  "name": "gamelabs",
  "productName": "GameLabs",
  "version": "1.0.0",
  "private": true,
  "description": "Launcher de jogos estilo console",
  "main": "dist-electron/main/index.js",
  "author": "ARK",
  "scripts": {
    "dev": "concurrently \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:ui": "vite",
    "dev:electron": "wait-on http://localhost:5173 && tsc -p tsconfig.node.json && cross-env ELECTRON_START_URL=http://localhost:5173 electron dist-electron/main/index.js",
    "build:ui": "vite build --config vite.config.ts",
    "build:main": "tsc -p tsconfig.node.json",
    "build": "npm run build:ui && npm run build:main",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.6.1",
    "node-7z": "^3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^25.5.0",
    "@types/node-7z": "^2.1.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  },
  "allowScripts": {
    "electron@41.0.3": true,
    "electron-winstaller@5.4.0": true
  }
}
